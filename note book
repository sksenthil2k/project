Add-Type -AssemblyName System.IO.Compression.FileSystem
$zip = [System.IO.Compression.ZipFile]::OpenRead("C:\Users\143500\costsheet\template\default_template.xlsx")
$entry = $zip.GetEntry("xl/workbook.xml")
$reader = New-Object System.IO.StreamReader($entry.Open())
$content = $reader.ReadToEnd()
$reader.Close()
$zip.Dispose()

# Extract and print just the sheet names
$matches = [regex]::Matches($content, 'name="([^"]+)"')
Write-Host "Sheet names found in template:"
$matches | ForEach-Object { Write-Host " -" $_.Groups[1].Value }
