# 1. Automatically find and patch CostRequest.java
$javaFile = Get-ChildItem -Recurse -Filter "CostRequest.java" | Select-Object -First 1
if ($javaFile) {
    $content = [System.IO.File]::ReadAllText($javaFile.FullName)
    
    # Regex replacement for getAccountName() method to support nullable value
    $pattern = 'public\s+String\s+getAccountName\(\)\s*\{\s*return\s+accountName;\s*\}'
    $replacement = 'public String getAccountName() { return accountName != null ? accountName : "default"; }'
    
    $content = [System.IO.Regex]::Replace($content, $pattern, $replacement)
    [System.IO.File]::WriteAllText($javaFile.FullName, $content)
    Write-Host "SUCCESS: CostRequest.java has been patched!" -ForegroundColor Green
} else {
    Write-Warning "WARNING: CostRequest.java not found in subdirectories."
}

# 2. Automatically find and patch index-D4MhRnQS.js
$jsFile = Get-ChildItem -Recurse -Filter "index-D4MhRnQS.js" | Select-Object -First 1
if ($jsFile) {
    $content = [System.IO.File]::ReadAllText($jsFile.FullName)
    $content = $content.Replace('"accountId":"default"', '"accountName":"default"')
    [System.IO.File]::WriteAllText($jsFile.FullName, $content)
    Write-Host "SUCCESS: index-D4MhRnQS.js has been patched!" -ForegroundColor Green
} else {
    Write-Warning "WARNING: index-D4MhRnQS.js not found in subdirectories."
}
