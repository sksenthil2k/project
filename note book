    private void setCellValue(double value, CellReference cellRef, Sheet sheet)
    {
        Row row = sheet.getRow(cellRef.getRow());
        Cell cell = row.getCell(cellRef.getCol());
        cell.setCellValue(value);
    }
    public void createFile() throws IOException {
        String filePath = outFilePath + File.separator + outputFileName+"_"+
                costRequest.getAccountName()+"_"+costRequest.getEnvironment()+ExcelMapper.FILE_EXTENSION;
        Path path = Paths.get(filePath);
        try {
            Files.write(path, new byte[0], StandardOpenOption.CREATE, StandardOpenOption.TRUNCATE_EXISTING);
            System.out.println("File created successfully.");
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public void writeExcel() throws IOException {
        String filePath = outFilePath + File.separator + outputFileName+"_"+
                costRequest.getAccountName()+"_"+costRequest.getEnvironment()+ExcelMapper.FILE_EXTENSION;
        File file  = new File(filePath);
        fileName = file.getName();
        FileOutputStream fos = new FileOutputStream(file);
        workbook.write(fos);
        workbook.close();
        fos.close();
    }
    private void copyFileToInputDirectory() throws IOException {
        String destFilePath = inputFilePath + File.separator + inputFileName+ExcelMapper.FILE_EXTENSION;
        String srcFilePath = outFilePath + File.separator + outputFileName+"_"+
                costRequest.getAccountName()+"_"+costRequest.getEnvironment()+ExcelMapper.FILE_EXTENSION;
        Path src = Paths.get(srcFilePath);
        Path dest = Paths.get(destFilePath);
        if (Files.notExists(dest)) {
            Files.createFile(dest); // Creates a new empty file
            System.out.println("file created as it was missing."+ destFilePath);
        }
        Files.copy(src, dest, StandardCopyOption.REPLACE_EXISTING);
    }
