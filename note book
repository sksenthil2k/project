$file = "src\main\java\com\healthproof\intplus\awscost\awsDev\CostExplorerDev.java"
$content = [System.IO.File]::ReadAllText($file)

# 1. Add required imports
$imports = @"
import software.amazon.awssdk.http.SdkHttpConfigurationOption;
import software.amazon.awssdk.http.apache.ApacheHttpClient;
import software.amazon.awssdk.utils.AttributeMap;
import software.amazon.awssdk.auth.credentials.ProfileCredentialsProvider;
"@

$content = $content.Replace("import software.amazon.awssdk.auth.credentials.ProfileCredentialsProvider;", $imports)

# 2. Modify the init() method to trust all SSL certificates
$oldInit = @"
    private void init() throws JsonProcessingException {
        this.model = new Model();
        credentialsProvider = ProfileCredentialsProvider.create(costRequest.getEnvironment().toUpperCase());
        caClient = CostExplorerClient.builder()
                .credentialsProvider(credentialsProvider)
                .build();
    }
"@

$newInit = @"
    private void init() throws JsonProcessingException {
        this.model = new Model();
        credentialsProvider = ProfileCredentialsProvider.create(costRequest.getEnvironment().toUpperCase());
        
        software.amazon.awssdk.http.SdkHttpClient httpClient = ApacheHttpClient.builder()
                .buildWithDefaults(AttributeMap.builder()
                        .put(SdkHttpConfigurationOption.TRUST_ALL_CERTIFICATES, Boolean.TRUE)
                        .build());

        caClient = CostExplorerClient.builder()
                .credentialsProvider(credentialsProvider)
                .httpClient(httpClient)
                .build();
    }
"@

# Normalize line endings to make replace robust
$content = $content.Replace($oldInit.Replace("`r`n", "`n"), $newInit.Replace("`r`n", "`n"))
$content = $content.Replace($oldInit.Replace("`n", "`r`n"), $newInit.Replace("`n", "`r`n"))

[System.IO.File]::WriteAllText($file, $content)
Write-Host "CostExplorerDev.java successfully configured to bypass SSL verification!"
