$body = '{"accountId":"default","startDate":"2024-01-01","endDate":"2024-12-31","granularity":"MONTHLY"}'

try {
    Invoke-RestMethod -Uri "http://localhost:8080/awscost/api/generate" `
        -Method POST `
        -ContentType "application/json" `
        -Body $body
} catch {
    $reader = New-Object System.IO.StreamReader($_.Exception.Response.GetResponseStream())
    $reader.ReadToEnd()
}
