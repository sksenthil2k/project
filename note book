Get-Content "$env:USERPROFILE\.aws\credentials" | ForEach-Object {
    if ($_ -match "aws_access_key_id|aws_secret_access_key|aws_session_token") {
        $parts = $_ -split "="
        $key = $parts[0].Trim()
        $val = $parts[1].Trim()
        if ($val.Length -gt 8) {
            "$key = $($val.Substring(0, 8))..."
        } else {
            "$key = $val"
        }
    } else {
        $_
    }
}
