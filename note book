$javaFile = Get-ChildItem -Recurse -Filter "CostRequest.java" | Select-Object -First 1
$content = [System.IO.File]::ReadAllText($javaFile.FullName)
$content = $content.Replace("    public String getAccountName() {`r`n        return accountName;`r`n    }", "    public String getAccountName() {`r`n        return accountName != null ? accountName : `"default`";`r`n    }")
[System.IO.File]::WriteAllText($javaFile.FullName, $content)
Write-Host "SUCCESS: CostRequest.java patched!" -ForegroundColor Green
