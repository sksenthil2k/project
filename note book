$pomFile = "pom.xml"
$pomContent = [System.IO.File]::ReadAllText($pomFile)

# The dependency block to add
$dependencyToAdd = @"
                <dependency>
                        <groupId>software.amazon.awssdk</groupId>
                        <artifactId>costexplorer</artifactId>
                        <version>2.20.63</version>
                </dependency>
                <dependency>
                        <groupId>software.amazon.awssdk</groupId>
                        <artifactId>apache-client</artifactId>
                        <version>2.20.63</version>
                </dependency>
"@

# Replace the single costexplorer block with both blocks
$oldDependency = @"
                <dependency>
                        <groupId>software.amazon.awssdk</groupId>
                        <artifactId>costexplorer</artifactId>
                        <version>2.20.63</version>
                </dependency>
"@

$pomContent = $pomContent.Replace($oldDependency, $dependencyToAdd)
[System.IO.File]::WriteAllText($pomFile, $pomContent)

Write-Host "pom.xml updated with apache-client dependency!"
