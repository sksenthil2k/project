# Fix 1: Update frontend JS to send accountName as "IBX"
$jsFile = Get-ChildItem -Recurse -Filter "index-D4MhRnQS.js" | Select-Object -First 1
$content = [System.IO.File]::ReadAllText($jsFile.FullName)
$content = $content.Replace('"accountName":"default"', '"accountName":"IBX"')
[System.IO.File]::WriteAllText($jsFile.FullName, $content)
Write-Host "SUCCESS: Frontend JS patched - accountName set to IBX!" -ForegroundColor Green

# Fix 2: Update CostRequest.java fallback from "default" to "IBX"
$javaFile = Get-ChildItem -Recurse -Filter "CostRequest.java" | Select-Object -First 1
$content = [System.IO.File]::ReadAllText($javaFile.FullName)
$content = $content.Replace(': "default"', ': "IBX"')
[System.IO.File]::WriteAllText($javaFile.FullName, $content)
Write-Host "SUCCESS: CostRequest.java fallback set to IBX!" -ForegroundColor Green
